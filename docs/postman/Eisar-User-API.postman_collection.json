{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "ایثار — API کاربری (Guest)",
    "description": "مجموعه Postman برای APIهای سمت کاربر/مهمان پلتفرم ایثار.\n\n## نحوه استفاده\n1. Environment مربوطه را import کنید (`Eisar-User-API.postman_environment.json`)\n2. در Postman: Settings → General → **Automatically follow redirects** را فعال کنید\n3. Cookie Jar را فعال نگه دارید (پیش‌فرض)\n4. ابتدا پوشه **Setup** → `01 - Get CSRF Token` را اجرا کنید\n5. سپس به ترتیب `02 - Send OTP` و `03 - Verify OTP` را اجرا کنید\n\n## کاربر تست\n- موبایل: `09120000001`\n- OTP: `123456`\n\n## نکته\nاحراز هویت Session-based است (Cookie `laravel_session`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('csrf_token') || pm.environment.get('csrf_token');",
          "if (token) {",
          "    pm.request.headers.upsert({ key: 'X-CSRF-TOKEN', value: token });",
          "}",
          "const baseUrl = pm.collectionVariables.get('base_url') || pm.environment.get('base_url');",
          "if (baseUrl) {",
          "    pm.collectionVariables.set('base_url', baseUrl);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "csrf_token", "value": "" },
    { "key": "mobile", "value": "09120000001" },
    { "key": "otp", "value": "123456" },
    { "key": "province_id", "value": "1" },
    { "key": "accommodation_id", "value": "1" },
    { "key": "room_type_id", "value": "1" },
    { "key": "room_rate_id", "value": "1" },
    { "key": "booking_id", "value": "1" },
    { "key": "check_in", "value": "2026-08-10" },
    { "key": "check_out", "value": "2026-08-13" },
    { "key": "guests", "value": "2" },
    { "key": "national_id", "value": "2221234567" },
    { "key": "rating", "value": "5" },
    { "key": "bale_init_data", "value": "" }
  ],
  "item": [
    {
      "name": "Setup — CSRF & Login",
      "description": "ابتدا این سه درخواست را به ترتیب اجرا کنید تا Session و CSRF تنظیم شود.",
      "item": [
        {
          "name": "01 - Get CSRF Token (GET /login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const html = pm.response.text();",
                  "const metaMatch = html.match(/name=[\"']csrf-token[\"']\\s+content=[\"']([^\"']+)[\"']/);",
                  "const inputMatch = html.match(/name=[\"']_token[\"']\\s+value=[\"']([^\"']+)[\"']/);",
                  "const token = (metaMatch && metaMatch[1]) || (inputMatch && inputMatch[1]);",
                  "if (token) {",
                  "    pm.collectionVariables.set('csrf_token', token);",
                  "    pm.environment.set('csrf_token', token);",
                  "    console.log('CSRF token saved:', token.substring(0, 10) + '...');",
                  "}",
                  "pm.test('CSRF token extracted', () => pm.expect(token).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "text/html" }],
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "02 - Send OTP (POST /login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Redirect to verify page', () => {",
                  "    pm.expect([302, 200]).to.include(pm.response.code);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('csrf_token')) {",
                  "    console.warn('Run 01 - Get CSRF Token first');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "Accept", "value": "text/html" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "mobile", "value": "{{mobile}}" },
                { "key": "_token", "value": "{{csrf_token}}" }
              ]
            },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "03 - Refresh CSRF (GET /login/verify)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const html = pm.response.text();",
                  "const metaMatch = html.match(/name=[\"']csrf-token[\"']\\s+content=[\"']([^\"']+)[\"']/);",
                  "const inputMatch = html.match(/name=[\"']_token[\"']\\s+value=[\"']([^\"']+)[\"']/);",
                  "const token = (metaMatch && metaMatch[1]) || (inputMatch && inputMatch[1]);",
                  "if (token) {",
                  "    pm.collectionVariables.set('csrf_token', token);",
                  "    pm.environment.set('csrf_token', token);",
                  "}",
                  "pm.test('CSRF token refreshed', () => pm.expect(token).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "text/html" }],
            "url": "{{base_url}}/login/verify"
          }
        },
        {
          "name": "04 - Verify OTP (POST /login/verify)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login successful (redirect)', () => {",
                  "    pm.expect([302, 200]).to.include(pm.response.code);",
                  "});",
                  "const cookies = pm.cookies.toObject();",
                  "pm.test('Session cookie set', () => {",
                  "    const hasSession = Object.keys(cookies).some(k => k.includes('session'));",
                  "    pm.expect(hasSession).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "Accept", "value": "text/html" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "otp", "value": "{{otp}}" },
                { "key": "_token", "value": "{{csrf_token}}" }
              ]
            },
            "url": "{{base_url}}/login/verify"
          }
        },
        {
          "name": "05 - Logout (POST /logout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "Accept", "value": "text/html" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{csrf_token}}" }
              ]
            },
            "url": "{{base_url}}/logout"
          }
        }
      ]
    },
