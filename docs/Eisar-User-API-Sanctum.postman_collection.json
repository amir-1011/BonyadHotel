{
  "info": {
    "_postman_id": "c3d4e5f6-a7b8-9012-cdef-123456789abc",
    "name": "ایثار — API v1 (Sanctum Bearer)",
    "description": "API کاربری با احراز هویت Bearer Token (Laravel Sanctum).\n\n## راه‌اندازی\n1. Environment `Eisar-User-API.postman_environment.json` را import کنید\n2. `Auth → Verify OTP` را اجرا کنید — توکن خودکار در `bearer_token` ذخیره می‌شود\n3. بقیه درخواست‌های احراز‌شده از این توکن استفاده می‌کنند\n\n## Base URL\n`{{base_url}}/api/v1`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "bearer_token", "value": "" },
    { "key": "mobile", "value": "09120000001" },
    { "key": "otp", "value": "123456" },
    { "key": "province_id", "value": "1" },
    { "key": "accommodation_id", "value": "1" },
    { "key": "room_type_id", "value": "1" },
    { "key": "room_rate_id", "value": "1" },
    { "key": "booking_id", "value": "1" },
    { "key": "check_in", "value": "2026-08-10" },
    { "key": "check_out", "value": "2026-08-13" },
    { "key": "guests", "value": "2" },
    { "key": "children_under_6", "value": "0" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/otp/send"
          }
        },
        {
          "name": "Verify OTP (get Bearer token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('bearer_token', data.token);",
                  "    pm.environment.set('bearer_token', data.token);",
                  "    console.log('Bearer token saved');",
                  "}",
                  "pm.test('Token received', () => pm.expect(data.token).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"otp\": \"{{otp}}\",\n  \"device_name\": \"postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/otp/verify"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "Logout (revoke current token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        },
        {
          "name": "Logout All Tokens",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/tokens"
          }
        }
      ]
    },
    {
      "name": "Public",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Provinces",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/provinces"
          }
        },
        {
          "name": "Cities by Province",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/provinces/{{province_id}}/cities"
          }
        },
        {
          "name": "Accommodations Index",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/accommodations?check_in={{check_in}}&check_out={{check_out}}&guests={{guests}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "accommodations"],
              "query": [
                { "key": "check_in", "value": "{{check_in}}" },
                { "key": "check_out", "value": "{{check_out}}" },
                { "key": "guests", "value": "{{guests}}" }
              ]
            }
          }
        },
        {
          "name": "Accommodation Show",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/accommodations/{{accommodation_id}}"
          }
        },
        {
          "name": "Rooms Availability",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/accommodations/{{accommodation_id}}/rooms-availability?check_in={{check_in}}&check_out={{check_out}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "accommodations", "{{accommodation_id}}", "rooms-availability"],
              "query": [
                { "key": "check_in", "value": "{{check_in}}" },
                { "key": "check_out", "value": "{{check_out}}" }
              ]
            }
          }
        },
        {
          "name": "Room Type Availability",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/room-types/{{room_type_id}}/availability?months=2026-08&room_rate_id={{room_rate_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "room-types", "{{room_type_id}}", "availability"],
              "query": [
                { "key": "months", "value": "2026-08" },
                { "key": "room_rate_id", "value": "{{room_rate_id}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"رضا صادقی\",\n  \"national_id\": \"2221234567\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/profile"
          }
        },
        {
          "name": "Verify National ID",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"2221234567\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/profile/verify-national-id"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "List Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/bookings"
          }
        },
        {
          "name": "Show Booking",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/bookings/{{booking_id}}"
          }
        },
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const id = pm.response.json().data.id;",
                  "    if (id) pm.collectionVariables.set('booking_id', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"check_in\": \"{{check_in}}\",\n  \"check_out\": \"{{check_out}}\",\n  \"guests\": {{guests}},\n  \"children_under_6\": {{children_under_6}},\n  \"room_type_id\": {{room_type_id}},\n  \"room_rate_id\": {{room_rate_id}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/accommodations/{{accommodation_id}}/bookings"
          }
        },
        {
          "name": "Download PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/pdf" }],
            "url": "{{base_url}}/api/v1/bookings/{{booking_id}}/pdf"
          }
        },
        {
          "name": "Cancellation Reasons",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/bookings/{{booking_id}}/cancellation-reasons"
          }
        },
        {
          "name": "Cancellation Preview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/bookings/{{booking_id}}/cancellation-preview"
          }
        },
        {
          "name": "Submit Cancellation Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellation_reason_id\": 1,\n  \"refund_account_number\": \"6037991234567890\",\n  \"refund_account_holder_name\": \"رضا صادقی\",\n  \"notes\": \"درخواست کنسلی از API\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/bookings/{{booking_id}}/cancellation-requests"
          }
        }
      ]
    },
    {
      "name": "Favorites",
      "item": [
        {
          "name": "List Favorites",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/favorites"
          }
        },
        {
          "name": "Toggle Favorite",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/favorites/{{accommodation_id}}/toggle"
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Submit Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"اقامت عالی بود.\",\n  \"booking_id\": {{booking_id}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/accommodations/{{accommodation_id}}/reviews"
          }
        }
      ]
    }
  ]
}
